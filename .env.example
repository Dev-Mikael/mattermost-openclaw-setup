# =============================================================
# mattermost-setup — Environment Configuration
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# .env is gitignored — NEVER commit it
# =============================================================

# ----- Git & GitHub -----
GITHUB_USER=your-github-username
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_REPO=mattermost-openclaw-setup
GITHUB_BRANCH=main

# ----- Cluster identity -----
CLUSTER_NAME=production
# ENVIRONMENT: "staging" or "production"
# Determines which terraform/environments/ directory is used
ENVIRONMENT=production

# ----- Networking -----
# Your domain name — must match the DNS record you point at the NLB
DOMAIN=modumichael.me
LETSENCRYPT_EMAIL=admin@modumichael.me

# ----- SSH -----
# Auto-populated by Terraform (terraform/modules/ec2-cluster writes the key file).
# You can leave these blank — 02-terraform-provision.sh fills them in.
SSH_USER=ubuntu
SSH_KEY_PATH=

# ----- Node IPs -----
# Auto-populated by 02-terraform-provision.sh from Terraform outputs.
# Leave blank here.
CP_PUBLIC_IP=
CP_PRIVATE_IP=
WORKER1_PUBLIC_IP=
WORKER2_PUBLIC_IP=
WORKER1_PRIVATE_IP=
WORKER2_PRIVATE_IP=

# ----- AWS / Terraform -----
AWS_REGION=us-east-1
SECRET_PREFIX=mattermost-openclaw-setup

# Auto-populated by 02-terraform-provision.sh
NLB_DNS_NAME=
S3_BUCKET_NAME=

# ----- Secrets -----
# DB_PASSWORD: used by 05-create-secrets.sh to push to AWS Secrets Manager.
# ESO then syncs this into the cluster as Kubernetes Secrets.
# Minimum 16 characters, no special chars that break shell quoting.
DB_PASSWORD=change-me-strong-password-minimum-16-chars

# ----- Mattermost admin account for OpenClaw setup -----
# Used locally by scripts/07-setup-openclaw.sh to create the Mattermost bot.
MM_ADMIN_USERNAME=admin
MM_ADMIN_PASSWORD=change-me-strong-admin-password
# MM_ADMIN_EMAIL=admin@modumichael.me

# ----- OpenClaw / KubeClaw -----
# Generate: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=change-me-strong-gateway-token-here

# Anthropic API key for Claude models via LiteLLM
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Gemini API key
GEMINI_API_KEY=your-gemini-key-here

# LiteLLM internal master key. Must start with sk-
# Generate: openssl rand -hex 24 | sed 's/^/sk-/'
LITELLM_MASTER_KEY=sk-change-me-litellm-key

# Bot behavior
MM_BOT_DM_POLICY=pairing
MM_BOT_CHANNELS=town-square
